  "curated_f3_decisions": [
    {
      "location": "1:1-18",
      "decision": "Keep succession, courage, Torah fidelity, land promise, and communal responsibility together.",
      "disposition": "APPROVE_QA"
    },
    {
      "location": "2:1-24",
      "decision": "Preserve Rahab's agency, risk, confession, negotiation, and protection of her household.",
      "disposition": "APPROVE_QA"
    },
    {
      "location": "5:13-6:27",
      "decision": "Translate Jericho and herem plainly in their ancient conquest narrative; do not make the violence a warrant for modern war or dispossession.",
      "disposition": "APPROVE_QA"
    },
    {
      "location": "7:1-26",
      "decision": "Retain the troubling corporate dimensions of Achan's offense and punishment rather than smoothing them away.",
      "disposition": "APPROVE_QA"
    },
    {
      "location": "8:30-35",
      "decision": "Keep altar, Torah inscription, blessing, curse, and the inclusion of resident aliens in the covenant assembly.",
      "disposition": "APPROVE_QA"
    },
    {
      "location": "9:1-27",
      "decision": "Preserve the Gibeonites' strategy, Israel's failed inquiry, sworn protection, and imposed labor.",
      "disposition": "APPROVE_QA"
    },
    {
      "location": "10:1-12:24",
      "decision": "Retain the warfare and cosmic imagery while resisting speculative scientific harmonization or modern political application.",
      "disposition": "APPROVE_QA"
    },
    {
      "location": "13:1-21:45",
      "decision": "Keep land allocation, dispossession, inheritance, refuge, and women's claims visible within the narrative's ancient setting.",
      "disposition": "APPROVE_QA"
    },
    {
      "location": "24:1-33",
      "decision": "Preserve the historical recital, covenant choice, witness, warning, and burial notices as the book's conclusion.",
      "disposition": "APPROVE_QA"
    }
  ],
