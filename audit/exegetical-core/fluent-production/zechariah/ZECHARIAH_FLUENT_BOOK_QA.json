    {
      "location": "1:7-6:15",
      "decision": "Preserve the night visions as symbolic scenes with angelic interpretation; do not convert their imagery into a modern prediction code.",
      "disposition": "APPROVE_QA"
    },
    {
      "location": "3:1-10",
      "decision": "Keep Joshua, the accuser, cleansing, priestly vocation, and the Branch within the vision's restored-community horizon.",
      "disposition": "APPROVE_QA"
    },
    {
      "location": "6:9-15",
      "decision": "Retain the crown and Branch symbolism without silently resolving the text's priestly and royal tensions.",
      "disposition": "APPROVE_QA"
    },
    {
      "location": "8:1-23",
      "decision": "Keep restoration concrete: truth, justice, secure public life, fruitful land, and nations seeking God.",
      "disposition": "APPROVE_QA"
    },
    {
      "location": "9:9-17",
      "decision": "Preserve the humble king, disarmament, peace to nations, and deliverance of prisoners.",
      "disposition": "APPROVE_QA"
    },
    {
      "location": "11:4-17",
      "decision": "Retain the difficult shepherd sign-act and its political critique without overidentifying unnamed figures.",
      "disposition": "APPROVE_QA"
    },
    {
      "location": "12:10",
      "decision": "Preserve the Hebrew pronoun and the one pierced without making the translation settle every later christological question.",
      "disposition": "APPROVE_QA"
    },
    {
      "location": "13:7-9",
      "decision": "Keep the struck shepherd, scattered flock, severe testing, and covenant renewal together.",
      "disposition": "APPROVE_QA"
    },
    {
      "location": "14:1-21",
      "decision": "Retain the day-of-the-LORD vision, cosmic transformation, nations, worship, judgment, and pervasive holiness without a speculative timetable.",
      "disposition": "APPROVE_QA"
    }
  ],
