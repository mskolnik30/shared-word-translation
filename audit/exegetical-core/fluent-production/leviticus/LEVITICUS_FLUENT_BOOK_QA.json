  "curated_f3_decisions": [
    {
      "location": "1:1-7:38",
      "decision": "Preserve distinctions among offerings and their ritual functions rather than flattening all sacrifice into one theory.",
      "disposition": "APPROVE_QA"
    },
    {
      "location": "8:1-10:20",
      "decision": "Keep priestly ordination, unauthorized fire, death, grief, and responsibility without inventing motives.",
      "disposition": "APPROVE_QA"
    },
    {
      "location": "11:1-15:33",
      "decision": "Translate ritual purity categories accurately without equating impurity with moral inferiority.",
      "disposition": "APPROVE_QA"
    },
    {
      "location": "16:1-34",
      "decision": "Retain the Day of Atonement's purification, two-goat ritual, priestly limits, and communal scope.",
      "disposition": "APPROVE_QA"
    },
    {
      "location": "17:1-22:33",
      "decision": "Keep holiness laws historically situated, including difficult sexual and penal texts; do not weaponize them against vulnerable people.",
      "disposition": "APPROVE_QA"
    },
    {
      "location": "23:1-25:55",
      "decision": "Preserve festivals, Sabbath, land rest, release, kinship, and Jubilee's economic claims.",
      "disposition": "APPROVE_QA"
    },
    {
      "location": "26:1-27:34",
      "decision": "Keep covenant blessing, terror, exile, restoration, vows, and valuation in their literary setting.",
      "disposition": "APPROVE_QA"
    }
  ],
