  "key_decisions": [
    {
      "location": "2 Samuel 3:7",
      "delta": "F3",
      "decision": "Supplies Ish-bosheth from verse 8 for the unnamed speaker; renders the sexual idiom directly while leaving the allegation in his speech.",
      "disposition": "REVIEW_PENDING"
    },
    {
      "location": "2 Samuel 3:8",
      "delta": "F3",
      "decision": "Retains the difficult Judah phrase and dog-head insult; treats steadfast love as Abner’s claim and does not invent either a confession or a denial.",
      "disposition": "REVIEW_PENDING"
    },
    {
      "location": "2 Samuel 3:12",
      "delta": "F3",
      "decision": "Takes the difficult location or representation expression as on his behalf; retains the open rhetorical question and hand image rather than supplying its answer.",
      "disposition": "REVIEW_PENDING"
    },
    {
      "location": "2 Samuel 3:14",
      "delta": "F3",
      "decision": "Keeps David’s marital claim and the bodily bride-price; retains a hundred here despite the two hundred delivered in 1 Samuel 18.",
      "disposition": "REVIEW_PENDING"
    },
    {
      "location": "2 Samuel 3:15",
      "delta": "F3",
      "decision": "Retains the narrator’s designation husband and the forcible transfer, following the read form Laish.",
      "disposition": "REVIEW_PENDING"
    },
    {
      "location": "2 Samuel 3:16",
      "delta": "F3",
      "decision": "Preserves the husband’s sustained grief and Abner’s abrupt order; does not supply Michal’s unreported response.",
      "disposition": "REVIEW_PENDING"
    },
    {
      "location": "2 Samuel 3:27",
      "delta": "F3",
      "decision": "Makes the deceptive approach readable while noting the uncertain privately or quietly expression; preserves the belly wound and blood vengeance motive.",
      "disposition": "REVIEW_PENDING"
    },
    {
      "location": "2 Samuel 3:29",
      "delta": "F3",
      "decision": "Retains all five elements of the curse, including the difficult spindle image; does not replace it silently with a crutch or moralize illness.",
      "disposition": "REVIEW_PENDING"
    },
    {
      "location": "2 Samuel 3:30",
      "delta": "F3",
      "decision": "Retains the narrator’s attribution to both brothers without inventing Abishai’s precise part in the murder.",
      "disposition": "REVIEW_PENDING"
    },
    {
      "location": "2 Samuel 3:39",
      "delta": "F3",
      "decision": "Preserves the contrast of soft or weak David with hard sons of Zeruiah and leaves the request for divine repayment as David’s speech.",
      "disposition": "REVIEW_PENDING"
    }
  ],
  "qa_scope": "structural"
