  "book_level_anchors": [
    {
      "id": "MATT.KINGDOM_HEAVEN",
      "decision": "Preserve Matthew's characteristic kingdom of heaven language; do not harmonize to Mark's kingdom of God except where Matthew itself says kingdom of God."
    },
    {
      "id": "MATT.FULFILL",
      "decision": "Preserve fulfill/fulfillment formulae and distinguish direct quotation, typological reuse, and narrative fulfillment without flattening them."
    },
    {
      "id": "MATT.RIGHTEOUSNESS",
      "decision": "Preserve righteousness across baptism, Sermon on the Mount, mercy, and kingdom ethics."
    },
    {
      "id": "MATT.SON_DAVID",
      "decision": "Preserve Son of David as a royal/messianic recognition network, especially among marginalized petitioners and Jerusalem crowds."
    },
    {
      "id": "MATT.SON_MAN",
      "decision": "Retain Son of Man without paraphrase across authority, suffering, judgment, and coming."
    },
    {
      "id": "MATT.FATHER",
      "decision": "Preserve Matthew's heavenly-Father language and its relation to prayer, imitation, secrecy, and communal life."
    },
    {
      "id": "MATT.MERCY",
      "decision": "Preserve mercy and Hosea 6:6 as a repeated interpretive key."
    },
    {
      "id": "MATT.LITTLE_FAITH",
      "decision": "Preserve little-faith/doubt language among disciples without converting every failure into unbelief."
    },
    {
      "id": "MATT.DISCIPLESHIP",
      "decision": "Preserve follow, cross, servant, child, forgiveness, and making-disciples networks."
    },
    {
      "id": "MATT.HAND_OVER",
      "decision": "Preserve paradidōmi as hand over across mission warnings and the passion."
    },
    {
      "id": "MATT.AUTHORITY",
      "decision": "Preserve authority from healings/forgiveness through Peter/assembly and the climactic all-authority commission."
    },
    {
      "id": "MATT.EMMANUEL",
      "decision": "Preserve the inclusion from Emmanuel (1:23) to I am with you (28:20)."
    },
    {
      "id": "MATT.SYNOPTIC",
      "decision": "Preserve genuine parallels with Mark where Matthew's Greek supports them, but never harmonize Matthew's distinct numbers, titles, quotations, wording, or narrative additions to Mark."
    }
  ],
